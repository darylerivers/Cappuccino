#!/usr/bin/env python3
"""
cappuccino-portfolio — Inspect live portfolio state, PnL, audit trail, and risk.

Usage:
    cappuccino-portfolio overview       # Portfolio summary + health
    cappuccino-portfolio pnl            # PnL history + drawdown analysis
    cappuccino-portfolio positions      # Current positions (if any)
    cappuccino-portfolio audit          # Audit trail from SQLite
    cappuccino-portfolio risk           # Risk metrics + circuit breaker
    cappuccino-portfolio events         # Recent events from audit log
"""

import argparse
import json
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path

# ── Paths ──────────────────────────────────────────────────────────────────────
BASE = Path.home() / "cappuccino"
MOM_DIR = BASE / "momentum"
STATE_FILE = MOM_DIR / "state.json"
AUDIT_DB = MOM_DIR / "audit.db"
CONFIG_FILE = MOM_DIR / "config.yaml"
METRICS_FILE = MOM_DIR / "backtest_metrics.json"


def load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def load_yaml(path: Path) -> dict:
    try:
        import yaml
        return yaml.safe_load(path.read_text()) or {}
    except Exception:
        return {}


# ── Commands ───────────────────────────────────────────────────────────────────

def cmd_overview(args):
    """Portfolio summary + health."""
    state = load_json(STATE_FILE)
    cfg = load_yaml(CONFIG_FILE)
    metrics = load_json(METRICS_FILE)

    pnl_hist = state.get("pnl_history", [])
    inception = float(state.get("inception_value") or cfg.get("capital_usdt", 500))
    peak = float(state.get("peak_value") or inception)
    current = float(pnl_hist[-1]["value"]) if pnl_hist else inception
    pnl_pct = (current / inception - 1) * 100 if inception else 0
    dd_pct = (current / peak - 1) * 100 if peak else 0

    print(f"\n{'='*70}")
    print(f"  PORTFOLIO OVERVIEW")
    print(f"{'='*70}")

    print(f"  Exchange:      {cfg.get('exchange', 'unknown')}")
    print(f"  Paper mode:    {cfg.get('paper_mode', 'unknown')}")
    print(f"  Assets:        {', '.join(cfg.get('assets', []))}")
    print(f"  Fee rate:      {cfg.get('fee_rate', 0)*100:.2f}%")
    print()

    print(f"  Capital:")
    print(f"    Inception:   ${inception:,.2f}")
    print(f"    Current:     ${current:,.2f}")
    print(f"    Peak:        ${peak:,.2f}")
    print(f"    PnL:         ${current - inception:+,.2f} ({pnl_pct:+.2f}%)")
    print(f"    Drawdown:    {dd_pct:+.2f}%")
    print()

    # Circuit breaker
    cb = state.get("circuit_breaker")
    if cb:
        print(f"  Circuit breaker: ACTIVE — {cb}")
    else:
        print(f"  Circuit breaker: OFF")

    max_dd = cfg.get("max_drawdown_pct", 15)
    print(f"  Max DD threshold: -{max_dd}%")
    print()

    # Positions
    positions = state.get("positions", {})
    if positions:
        print(f"  Open positions ({len(positions)}):")
        for asset, pos in positions.items():
            qty = pos.get("qty", 0)
            entry = pos.get("entry_price", 0)
            print(f"    {asset}: {qty} @ ${entry:,.2f}")
    else:
        print(f"  Open positions: none")
    print()

    # Rebalancing
    print(f"  Rebalancing:")
    print(f"    Interval:    {cfg.get('rebalance_interval_hours', 'N/A')}h")
    print(f"    Count:       {state.get('rebal_count', 0)}")
    print(f"    Last:        {state.get('last_rebal_ts', 'N/A')}")
    print(f"    Top N:       {cfg.get('top_n', 'N/A')}")
    print()

    # Errors
    errs = state.get("consecutive_errors", 0)
    max_errs = cfg.get("max_consecutive_errors", 3)
    print(f"  Consecutive errors: {errs}/{max_errs}")
    print()


def cmd_pnl(args):
    """PnL history + drawdown analysis."""
    state = load_json(STATE_FILE)
    cfg = load_yaml(CONFIG_FILE)

    pnl_hist = state.get("pnl_history", [])
    if not pnl_hist:
        print("No PnL history found")
        return

    inception = float(state.get("inception_value") or cfg.get("capital_usdt", 500))

    # Parse values
    values = []
    for entry in pnl_hist:
        ts = datetime.fromisoformat(entry["ts"])
        val = float(entry["value"])
        pnl = (val / inception - 1) * 100
        values.append((ts, val, pnl))

    # Stats
    vals = [v[1] for v in values]
    pnls = [v[2] for v in values]
    peak_val = max(vals)
    trough_val = min(vals)
    max_dd = (min(vals) / peak_val - 1) * 100 if peak_val else 0
    current = vals[-1]
    current_dd = (current / peak_val - 1) * 100 if peak_val else 0

    print(f"\n{'='*70}")
    print(f"  PNL HISTORY")
    print(f"{'='*70}")
    print(f"  Data points: {len(values)}")
    print(f"  Time range:  {values[0][0].strftime('%Y-%m-%d %H:%M')} → "
          f"{values[-1][0].strftime('%Y-%m-%d %H:%M')}")
    print()

    print(f"  Current:     ${current:,.2f} ({pnls[-1]:+.2f}%)")
    print(f"  Peak:        ${peak_val:,.2f}")
    print(f"  Trough:      ${trough_val:,.2f}")
    print(f"  Max DD:      {max_dd:+.2f}%")
    print(f"  Current DD:  {current_dd:+.2f}%")
    print()

    # Recent PnL
    print(f"  Last 10 data points:")
    print(f"    {'Timestamp':>20} {'Value':>12} {'PnL%':>8}")
    print(f"    {'-'*20} {'-'*12} {'-'*8}")
    for ts, val, pnl in values[-10:]:
        print(f"    {ts.strftime('%Y-%m-%d %H:%M'):>20} ${val:>10,.2f} {pnl:>+7.2f}%")

    # Hourly PnL changes
    print(f"\n  Hourly PnL changes (last 24):")
    changes = []
    for i in range(1, len(values)):
        delta = values[i][1] - values[i-1][1]
        changes.append((values[i][0], delta))

    for ts, delta in changes[-24:]:
        sign = "+" if delta >= 0 else ""
        print(f"    {ts.strftime('%Y-%m-%d %H:%M')}  {sign}${delta:,.2f}")

    print()


def cmd_positions(args):
    """Current positions."""
    state = load_json(STATE_FILE)
    cfg = load_yaml(CONFIG_FILE)
    positions = state.get("positions", {})

    print(f"\n{'='*70}")
    print(f"  POSITIONS")
    print(f"{'='*70}")

    if not positions:
        print("  No open positions")
    else:
        print(f"  Open positions: {len(positions)}")
        print()
        for asset, pos in positions.items():
            print(f"  {asset}:")
            for k, v in pos.items():
                if isinstance(v, float):
                    print(f"    {k}: {v:.6f}")
                else:
                    print(f"    {k}: {v}")
            print()

    # Config limits
    max_pos = cfg.get("max_position_pct", 0)
    print(f"  Config limits:")
    print(f"    Max position: {max_pos*100:.0f}% of portfolio")
    print(f"    Max single asset drop: {cfg.get('single_asset_drop_pct', 0):.1f}%")

    print()


def cmd_audit(args):
    """Audit trail from SQLite."""
    if not AUDIT_DB.exists():
        print(f"Audit database not found: {AUDIT_DB}")
        return

    conn = sqlite3.connect(str(AUDIT_DB))
    cur = conn.cursor()

    # Snapshot summary
    cur.execute("SELECT COUNT(*) FROM snapshots")
    snap_count = cur.fetchone()[0]

    cur.execute("SELECT COUNT(*) FROM trades")
    trade_count = cur.fetchone()[0]

    cur.execute("SELECT COUNT(*) FROM events")
    event_count = cur.fetchone()[0]

    print(f"\n{'='*70}")
    print(f"  AUDIT TRAIL")
    print(f"{'='*70}")
    print(f"  Snapshots: {snap_count}")
    print(f"  Trades:    {trade_count}")
    print(f"  Events:    {event_count:,}")
    print()

    # Latest snapshots
    if snap_count > 0:
        print(f"  Latest 5 snapshots:")
        cur.execute("""
            SELECT ts, portfolio_value, inception_value, pnl_pct,
                   drawdown_pct, in_regime, btc_price
            FROM snapshots ORDER BY ts DESC LIMIT 5
        """)
        print(f"    {'Timestamp':>20} {'Value':>10} {'PnL%':>8} "
              f"{'DD%':>8} {'Regime':>8} {'BTC':>10}")
        print(f"    {'-'*20} {'-'*10} {'-'*8} {'-'*8} {'-'*8} {'-'*10}")
        for row in cur.fetchall():
            ts_str = row[0][:19] if row[0] else "N/A"
            regime = "BULL" if row[5] else "BEAR" if row[5] is not None else "N/A"
            btc = f"${row[6]:,.0f}" if row[6] else "N/A"
            print(f"    {ts_str:>20} ${row[1]:>8,.0f} {row[3]:>+7.2f}% "
                  f"{row[4]:>+7.2f}% {regime:>8} {btc:>10}")
        print()

    # Recent trades
    if trade_count > 0:
        print(f"  Latest 10 trades:")
        cur.execute("""
            SELECT ts, asset, side, qty, fill_px, notional_usd, fee_usd, paper
            FROM trades ORDER BY ts DESC LIMIT 10
        """)
        print(f"    {'Timestamp':>20} {'Asset':<6} {'Side':>4} {'Qty':>10} "
              f"{'Price':>10} {'Notional':>10} {'Fee':>8} {'Paper':>5}")
        print(f"    {'-'*20} {'-'*6} {'-'*4} {'-'*10} {'-'*10} {'-'*10} {'-'*8} {'-'*5}")
        for row in cur.fetchall():
            ts_str = row[0][:19] if row[0] else "N/A"
            paper = "Yes" if row[7] else "No"
            print(f"    {ts_str:>20} {row[1]:<6} {row[2]:>4} {row[3]:>10.6f} "
                  f"${row[4]:>8.2f} ${row[5]:>8.2f} ${row[6]:>6.4f} {paper:>5}")
        print()

    # Event types
    if event_count > 0:
        print(f"  Event type distribution:")
        cur.execute("""
            SELECT event, COUNT(*) as cnt
            FROM events GROUP BY event ORDER BY cnt DESC LIMIT 15
        """)
        for row in cur.fetchall():
            print(f"    {row[0]:<40} {row[1]:>10,}")

    conn.close()
    print()


def cmd_risk(args):
    """Risk metrics + circuit breaker."""
    state = load_json(STATE_FILE)
    cfg = load_yaml(CONFIG_FILE)
    metrics = load_json(METRICS_FILE)

    pnl_hist = state.get("pnl_history", [])
    inception = float(state.get("inception_value") or cfg.get("capital_usdt", 500))
    peak = float(state.get("peak_value") or inception)
    current = float(pnl_hist[-1]["value"]) if pnl_hist else inception

    print(f"\n{'='*70}")
    print(f"  RISK METRICS")
    print(f"{'='*70}")

    # Current risk
    dd_pct = (current / peak - 1) * 100 if peak else 0
    max_dd_threshold = cfg.get("max_drawdown_pct", 15)
    dd_buffer = max_dd_threshold + dd_pct  # positive = buffer remaining

    print(f"  Current drawdown:  {dd_pct:+.2f}%")
    print(f"  Max DD threshold:  -{max_dd_threshold}%.0f")
    print(f"  Buffer remaining:  {dd_buffer:.2f}%")

    cb = state.get("circuit_breaker")
    if cb:
        print(f"  Circuit breaker:   ACTIVE — {cb}")
    else:
        print(f"  Circuit breaker:   OFF")

    # Single asset risk
    single_drop = cfg.get("single_asset_drop_pct", 8)
    print(f"  Single asset halt: -{single_drop}% in 1 hour")

    # Error risk
    errs = state.get("consecutive_errors", 0)
    max_errs = cfg.get("max_consecutive_errors", 3)
    print(f"  Consecutive errors: {errs}/{max_errs}")
    if errs >= max_errs:
        print(f"  ERROR THRESHOLD REACHED")

    # Backtest risk context
    fs = metrics.get("full_sample", {})
    if fs:
        print(f"\n  Backtest risk context:")
        print(f"    Max DD (backtest):    {fs.get('max_dd_pct', 0):.2f}%")
        print(f"    Fee drag:             {fs.get('fee_drag_pct_yr', 0):.2f}%/yr")
        print(f"    Turnover:             {fs.get('turnover_per_day', 0):.4f}/day")
        print(f"    Avg holding period:   {fs.get('avg_holding_hrs', 0):.1f}h")
        print(f"    Time invested:        {fs.get('pct_time_invested', 0):.1f}%")

    # Regime
    last_regime = state.get("last_regime")
    if last_regime:
        print(f"\n  Current regime: {last_regime}")
        regime_ma = cfg.get("regime_ma_bars", 168)
        print(f"  Regime MA: {regime_ma}h ({regime_ma/24:.1f} days)")

    print()


def cmd_events(args):
    """Recent events from audit log."""
    if not AUDIT_DB.exists():
        print(f"Audit database not found: {AUDIT_DB}")
        return

    conn = sqlite3.connect(str(AUDIT_DB))
    cur = conn.cursor()

    cur.execute("SELECT COUNT(*) FROM events")
    total = cur.fetchone()[0]

    print(f"\n{'='*70}")
    print(f"  RECENT EVENTS ({total:,} total)")
    print(f"{'='*70}")

    cur.execute("""
        SELECT ts, event, payload
        FROM events ORDER BY ts DESC LIMIT 20
    """)

    for row in cur.fetchall():
        ts_str = row[0][:19] if row[0] else "N/A"
        payload_preview = ""
        if row[2]:
            try:
                p = json.loads(row[2])
                # Show key fields
                if isinstance(p, dict):
                    parts = []
                    for k in ["asset", "side", "pnl_pct", "regime", "error"]:
                        if k in p:
                            parts.append(f"{k}={p[k]}")
                    payload_preview = " | ".join(parts)
                    if not payload_preview:
                        payload_preview = str(p)[:80]
                else:
                    payload_preview = str(p)[:80]
            except Exception:
                payload_preview = str(row[2])[:80]

        print(f"  {ts_str}  {row[1]:<30} {payload_preview}")

    conn.close()
    print()


# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Cappuccino portfolio inspection tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("overview", help="Portfolio summary + health")
    sub.add_parser("pnl", help="PnL history + drawdown analysis")
    sub.add_parser("positions", help="Current positions")
    sub.add_parser("audit", help="Audit trail from SQLite")
    sub.add_parser("risk", help="Risk metrics + circuit breaker")
    sub.add_parser("events", help="Recent events from audit log")

    args = parser.parse_args()

    cmds = {
        "overview": cmd_overview,
        "pnl": cmd_pnl,
        "positions": cmd_positions,
        "audit": cmd_audit,
        "risk": cmd_risk,
        "events": cmd_events,
    }
    cmds[args.command](args)


if __name__ == "__main__":
    main()
